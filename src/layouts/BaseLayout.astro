---
import '../styles/tokens.css';
import '../styles/layout.css';
import '../styles/home.css';
import '../styles/pages.css';
import '../styles/popup.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DiscountPopup from '../components/DiscountPopup.astro';
import Lightbox from '../components/Lightbox.astro';

export interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/ua/" or "/ua/about/" — used for canonical + hreflang
  enPath?: string; // matching EN url; defaults to the same path with /ua/ swapped for /en/
  ukPath?: string; // matching UA url when this is an EN page with a different slug; defaults to the same path with /en/ swapped for /ua/
  lang?: 'uk' | 'en';
  noindex?: boolean;
  jsonLd?: object | object[];
}

const { title, description, path, enPath, ukPath: ukPathProp, lang = 'uk', noindex = false, jsonLd } = Astro.props;
const site = 'https://sacredinkacademy.com';
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ukPath = ukPathProp ?? (lang === 'en' ? path.replace(/^\/en\//, '/ua/') : path);
const finalEnPath = enPath ?? (lang === 'en' ? path : path.replace(/^\/ua\//, '/en/'));
const stickyCta = lang === 'en'
  ? { href: '/en/free-tattoo-course/', label: 'Try it for free' }
  : { href: '/ua/free-tattoo-course/', label: 'Спробувати безкоштовно' };
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex,follow">}
  <link rel="canonical" href={`${site}${path}`}>
  <link rel="alternate" hreflang="uk" href={`${site}${ukPath}`}>
  <link rel="alternate" hreflang="en" href={`${site}${finalEnPath}`}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={`${site}${path}`}>
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'uk_UA'}>
  <link rel="icon" href="/assets/logo/icon-black.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  {jsonLdList.map((obj) => (
    <script type="application/ld+json" set:html={JSON.stringify(obj)} />
  ))}
</head>
<body>
  <Header lang={lang} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
  <div class="sticky-cta"><a href={stickyCta.href} class="btn btn-primary">{stickyCta.label}</a></div>
  <DiscountPopup lang={lang} />
  <Lightbox lang={lang} />
  <script src="/js/popup.js" is:inline></script>
  <script src="/js/app.js" is:inline></script>
</body>
</html>
