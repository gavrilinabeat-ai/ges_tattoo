---
// Horizontal scrolling gallery of student/academy tattoo work photos, with lightbox on click.
export interface Props {
  items: { src: string; alt: string }[];
  lang?: 'uk' | 'en';
}
const { items, lang = 'uk' } = Astro.props;
const enlargeLabel = lang === 'en' ? 'Enlarge work' : 'Збільшити роботу';
---
<div class="works-scroller">
  {items.map((w) => (
    <button type="button" class="review-shot" data-lightbox-src={w.src} aria-label={enlargeLabel}>
      <img src={w.src} alt={w.alt} loading="lazy">
    </button>
  ))}
</div>
