<div class="overlay" id="discountOverlay">
  <div class="discount-modal" role="dialog" aria-modal="true" aria-labelledby="discountTitle">
    <button class="modal-close" id="discountClose" aria-label="Закрити">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>

    <div class="modal-step is-active" data-step="reveal">
      <div class="modal-brand"><img src="/assets/logo/wordmark-black.svg" alt="Sacred Ink Academy"></div>
      <p class="modal-kicker">Подарунок для тебе</p>
      <h2 id="discountTitle" class="modal-percent">−10%</h2>
      <p class="modal-headline">Відкрий свою знижку на навчання</p>

      <div class="reveal-card" id="revealCard">
        <div class="reveal-card-base">
          <span class="rc-amount">−10%</span>
          <span class="rc-caption">Знижка розблокована</span>
        </div>
        <div class="reveal-card-cover" id="revealCover">
          <svg viewBox="0 0 24 24" fill="none"><path d="M3 12h18M15 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Проведи, щоб відкрити</span>
        </div>
      </div>
      <button class="reveal-fallback" id="revealFallback">Відкрити подарунок</button>
    </div>

    <div class="modal-step" data-step="email">
      <div class="modal-brand"><img src="/assets/logo/wordmark-black.svg" alt="Sacred Ink Academy"></div>
      <p class="modal-kicker">Подарунок для тебе</p>
      <h2 class="modal-percent">−10%</h2>
      <p class="modal-headline">Знижка на навчання Sacred Ink Academy</p>
      <p class="modal-lead">Залиш свою пошту — і ми надішлемо тобі персональний промокод на знижку 10%.</p>

      <form class="email-form" id="discountForm" novalidate>
        <label for="discountEmail" class="visually-hidden">Твоя пошта</label>
        <input type="email" id="discountEmail" class="email-field" placeholder="Твоя пошта" autocomplete="email" required>
        <span class="email-error" id="discountEmailError">Перевір, будь ласка, адресу пошти</span>
        <button type="submit" class="btn btn-primary">Отримати промокод →</button>
      </form>
      <p class="email-consent">Без спаму. Лише промокод та корисні матеріали Sacred Ink. Надсилаючи email, ти погоджуєшся з <a href="/ua/privacy/" style="text-decoration:underline;">Privacy Policy</a>.</p>
    </div>

    <div class="modal-step" data-step="success">
      <div class="success-icon">
        <svg viewBox="0 0 24 24" fill="none"><path d="M4 12.5l5 5L20 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h2 class="modal-headline" style="font-size:20px;">Твій промокод готовий</h2>
      <p class="modal-lead">Знижка 10% на навчання Sacred Ink Academy</p>

      <div class="promo-field">
        <span class="promo-code" id="promoCode">SACREDINK10</span>
        <button class="promo-copy" id="promoCopyBtn" type="button">Скопіювати</button>
      </div>
      <p class="promo-note">Ми також надіслали промокод на твою пошту.</p>

      <div class="success-actions">
        <a href="/ua/tattoo-course/" class="btn btn-primary">Перейти до навчання →</a>
        <a href="/ua/free-tattoo-course/" class="btn btn-ghost">Спробувати 5 днів безкоштовно</a>
      </div>
    </div>
  </div>
</div>

<button class="discount-fab" id="discountFab" aria-label="Відкрити знижку 10%">−10%</button>
