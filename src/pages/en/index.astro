---
import '../../styles/tokens.css';
import '../../styles/layout.css';
import '../../styles/home.css';
import '../../styles/pages.css';
---
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sacred Ink Academy — online tattoo school</title>
  <meta name="description" content="Sacred Ink Academy — online tattoo school. English content is on its way.">
  <link rel="canonical" href="https://sacredinkacademy.com/en/">
  <link rel="alternate" hreflang="uk" href="https://sacredinkacademy.com/ua/">
  <link rel="alternate" hreflang="en" href="https://sacredinkacademy.com/en/">
  <link rel="icon" href="/assets/logo/icon-black.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/en/" class="brand"><img src="/assets/logo/wordmark-black.svg" alt="Sacred Ink Academy"></a>
      <div class="header-right">
        <div class="lang-toggle">
          <a href="/ua/">UA</a>
          <span aria-hidden="true">/</span>
          <a href="#" class="is-active">EN</a>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section class="section page-hero" style="text-align:center;">
      <div class="container">
        <span class="eyebrow">English version</span>
        <h1 style="margin-top:16px;">English content<br>is on its way</h1>
        <p class="hero-sub" style="margin-left:auto; margin-right:auto;">We're building the English version of Sacred Ink Academy with content written for an international audience — not a machine translation. In the meantime, explore the Ukrainian site.</p>
        <div class="hero-actions" style="justify-content:center; margin-top:32px;">
          <a href="/ua/" class="btn btn-primary">Переглянути українську версію</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-bottom" style="border-top:none; padding-top:0;">
      <span>© {new Date().getFullYear()} Sacred Ink Academy</span>
    </div>
  </footer>
</body>
</html>
