---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Sacred Ink knowledge base — everything about the tattoo artist profession"
  description="Sacred Ink Academy knowledge base: getting started, technique, equipment, safety & skin, career and clients."
  path="/en/knowledge/"
  enPath="/en/knowledge/"
  lang="en"
>
  <section class="section page-hero">
    <div class="container">
      <nav class="breadcrumbs"><a href="/en/">Home</a><span>/</span><span>Knowledge base</span></nav>
      <span class="eyebrow">Knowledge base</span>
      <h1 style="margin-top:16px;">Sacred Ink<br>knowledge base</h1>
      <p class="hero-sub">Professional articles on technique, equipment, safety, and a tattoo artist's career — from Sacred Ink Academy.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="stub-note" style="max-width:720px;">
        <strong>The English knowledge base is on its way.</strong> Our full library of articles is currently written in Ukrainian. We're translating it for an international audience — in the meantime, you can browse the <a href="/ua/knowledge/" style="text-decoration:underline;">Ukrainian knowledge base</a>, or reach out with a specific question and Kateryna will answer directly.
      </div>
    </div>
  </section>

  <section class="section section-black final-cta">
    <div class="container">
      <span class="eyebrow" style="opacity:0.7;">Sacred Ink Academy</span>
      <h2 style="margin-top:16px;">Ready to go beyond theory?</h2>
      <a href="/en/free-tattoo-course/" class="btn btn-inverse">Try 5 days for free</a>
    </div>
  </section>
</BaseLayout>
