---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Terms & Conditions — Sacred Ink Academy"
  description="Terms & Conditions for Sacred Ink Academy."
  path="/en/terms/"
  lang="en"
  noindex={true}
>
  <section class="section page-hero" style="padding-bottom:0;">
    <div class="container">
      <nav class="breadcrumbs"><a href="/en/">Home</a><span>/</span><span>Terms &amp; Conditions</span></nav>
      <span class="eyebrow">Legal information</span>
      <h1 style="margin-top:16px; font-size:clamp(28px,4vw,42px);">Terms &amp; Conditions</h1>
    </div>
  </section>

  <section class="section">
    <div class="container legal-body content-block">
      <div class="stub-note" style="margin-top:0;">This is a Terms & Conditions template. Replace it with a legally reviewed version before launch — including payment terms, refunds, and liability for each party.</div>
      <h2>General provisions</h2>
      <p>By using the Sacred Ink Academy website, you agree to these terms.</p>
      <h2>Training & payment</h2>
      <p>Payment terms, installment plans, and refund conditions for each training format are provided individually when you submit an application.</p>
      <h2>Intellectual property</h2>
      <p>All course materials are the property of Sacred Ink Academy and may not be distributed without consent.</p>
    </div>
  </section>
</BaseLayout>
