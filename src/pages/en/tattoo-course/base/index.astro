---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Base — Tattoo Master from Scratch',
  description: 'The "Base" format: master tattooing from scratch at your own pace, with written feedback on every piece.',
  provider: { '@type': 'EducationalOrganization', name: 'Sacred Ink Academy', sameAs: 'https://sacredinkacademy.com/en/' },
};

const howItWorks = [
  ['⏱ Training', '2 months'],
  ['📂 Access to materials', '3 months'],
  ['✅ Homework review', '2 months'],
  ['💬 Feedback format', 'Written/video feedback on your work'],
  ['🎥 Live calls', 'No live calls'],
];

const blocks = [
  {
    n: '01',
    icon: '🔬',
    title: 'Theory. Before you touch a machine',
    intro: 'Here you learn everything an artist needs to know before their first session:',
    items: [
      'Skin structure — why it\'s critical to your results',
      'Sterility & disinfection — how to keep your client safe',
      'Allergies & contraindications — who can\'t get a tattoo, and why',
      'Emergencies — what to do if something goes wrong',
      'Printing & stencils — hand transfer, machine transfer, printer overview',
    ],
    quote: 'Before you pick up a machine, you already understand what, how, and why.',
  },
  {
    n: '02',
    icon: '⚙️',
    title: 'Getting ready for practice',
    items: [
      'What tattoo machines exist and which to choose to start',
      'Machine setup: needle depth, voltage, cartridges',
      'Building your workspace from scratch',
      'Supplies & consumables — what to buy, what not to overpay for',
    ],
  },
  {
    n: '03',
    icon: '🎯',
    title: 'Your first hands-on lesson. From theory to practice',
    intro: 'We turn on the tattoo machine, set it up, get your hand position right — and you do your first exercises along with the video.',
    items: [],
  },
  {
    n: '04',
    icon: '✏️',
    title: 'Techniques',
    groups: [
      { label: 'Outline (classic, whip, dynamic)', items: ['Hand position & motor skills', 'Lettering', 'Graphic, sketch, engraving style', 'Whip and dynamic outline'] },
      { label: 'Whip shading', items: ['Intro to the technique', 'Flowers sketch', 'Bird sketch', 'Tiger cub sketch'] },
      { label: 'Magnum coloring', items: ['How to lay down solid, even color', 'Coloring and shading practice'] },
    ],
  },
  {
    n: '05',
    icon: '🧑‍🤝‍🧑',
    title: 'Moving to real clients',
    items: [
      'How to set up your workspace for a real person',
      'Working with real skin — how it differs from practice skin',
      'How to find your first models and communicate with them properly',
      'What to say to a client before, during, and after a session',
      'Aftercare — what to explain to your client',
    ],
  },
  {
    n: '06',
    icon: '📱',
    title: 'Instagram and your first clients',
    intro: "So you're not left wondering \"what do I even post\" after training:",
    items: [
      'How to set up your profile bio',
      'Where to start a fresh artist page from scratch',
      '30 content ideas — a ready-made list',
      'How to look like a working artist before you have your first clients',
    ],
  },
];

const included = [
  '📹 Video lessons with step-by-step explanations',
  '📝 Practical homework after every block',
  '💬 Written feedback from Kateryna on every piece of your work',
  '📂 3 months of access to all materials',
  '🗂 A Notion ecosystem with materials and templates',
  '📋 30 content ideas as a bonus',
];

const forWhom = [
  'You\'ve wanted to get into tattooing for a while, but never had the chance or the confidence',
  'You\'re independent and want to learn at your own pace',
  'Feedback on your work matters to you, but you don\'t want constant calls and schedules',
  'You\'ve studied somewhere before but feel gaps in your theory or technique',
  'You live abroad and want to master a new profession',
];

const faq = [
  ['Do I need a machine to get started?', 'For the theory and prep blocks — no. For practice — yes, you\'ll need a basic tattoo machine. I\'ll help you pick one.'],
  ['Will this work if I\'ve never drawn before?', 'Yes. Most techniques in Base don\'t require an art background — just patience and practice.'],
  ['When do I get access?', 'Right after payment.'],
  ['What if I can\'t finish my homework within 2 months?', 'Access to the materials stays open for 3 months — you can keep watching and learning, but I give feedback on your work during the first 2 months.'],
];
---
<BaseLayout
  title="Base — tattoo training format | Sacred Ink Academy"
  description="The 'Base' format: master tattooing from scratch at your own pace. Video lessons, homework, written feedback on every piece, 3 months of access. €379."
  path="/en/tattoo-course/base/"
  ukPath="/ua/tattoo-course/baza/"
  lang="en"
  jsonLd={jsonLd}
>
  <section class="section page-hero">
    <div class="container">
      <nav class="breadcrumbs"><a href="/en/">Home</a><span>/</span><a href="/en/tattoo-course/">Program</a><span>/</span><span>Base</span></nav>
      <span class="eyebrow">Training format</span>
      <h1 style="margin-top:16px;">Base</h1>
      <p class="hero-sub">Master tattooing from scratch, at your own pace. A format for those who want to get into tattooing independently — but not blindly: you move at your own rhythm, while Kateryna reviews your work and corrects you, so you're never learning from your mistakes alone.</p>
      <div class="hero-actions">
        <a href="#price" class="btn btn-primary">See the price</a>
        <a href="/en/tattoo-course/" class="btn btn-ghost">← All training formats</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <span class="section-index">[1]</span>
      <h2 style="margin-top:12px;">How it works</h2>
      <div class="stat-row" style="margin-top:28px; border-top:1px solid rgba(15,3,2,.12); border-bottom:1px solid rgba(15,3,2,.12); grid-template-columns:1fr;">
        {howItWorks.map(([label, value]) => (
          <div class="stat-item" style="text-align:left; display:flex; justify-content:space-between; align-items:center; gap:16px; border-right:none !important; border-bottom:1px solid rgba(15,3,2,.1);">
            <span style="font-size:14px; font-weight:600;">{label}</span>
            <span style="font-size:15px; font-weight:800;">{value}</span>
          </div>
        ))}
      </div>
      <p class="content-block" style="margin-top:24px; opacity:0.75;">You can send in homework for 2 months — Kateryna reviews every piece and replies. No calls, just you, the materials, and feedback on your own work.</p>
    </div>
  </section>

  <section class="section section-alt" id="program">
    <div class="container">
      <span class="section-index">[2]</span>
      <h2 style="margin-top:12px;">Program</h2>
      <div style="margin-top:32px; display:flex; flex-direction:column; gap:36px;">
        {blocks.map((b) => (
          <div style="border-top:1px solid rgba(15,3,2,.14); padding-top:24px;">
            <div style="display:flex; align-items:baseline; gap:14px;">
              <span style="font-size:13px; font-weight:800; opacity:0.4;">{b.n}</span>
              <h3 style="margin:0;">{b.icon} Block {parseInt(b.n)} — {b.title}</h3>
            </div>
            {b.intro && <p style="margin-top:12px; opacity:0.75; font-size:15px;">{b.intro}</p>}
            {b.items && b.items.length > 0 && (
              <ul style="margin-top:14px; padding-left:20px; display:flex; flex-direction:column; gap:8px;">
                {b.items.map((it) => <li style="font-size:15px; opacity:0.85;">{it}</li>)}
              </ul>
            )}
            {b.groups && (
              <div style="margin-top:14px; display:flex; flex-direction:column; gap:18px;">
                {b.groups.map((g) => (
                  <div>
                    <div style="font-weight:700; font-size:14px; margin-bottom:8px;">{g.label}</div>
                    <ul style="padding-left:20px; display:flex; flex-direction:column; gap:6px;">
                      {g.items.map((it) => <li style="font-size:15px; opacity:0.85;">{it}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            )}
            {b.quote && <p style="margin-top:14px; font-style:italic; opacity:0.6; font-size:14px;">« {b.quote} »</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-index">[3]</span>
      <h2 style="margin-top:12px;">What you get in the Base format</h2>
      <ul class="testdrive-checks" style="margin-top:26px; max-width:640px;">
        {included.map((it) => (
          <li><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9.5l4 4 8-8" stroke="currentColor" stroke-width="1.6"/></svg> {it}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="section-index">[4]</span>
      <h2 style="margin-top:12px;">Who Base is for</h2>
      <div class="for-whom-grid" style="margin-top:28px;">
        {forWhom.map((t, i) => (
          <div class="fw-card"><span class="fw-num">{String(i + 1).padStart(2, '0')}</span><span class="fw-text">{t}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-black" id="price">
    <div class="container" style="text-align:center;">
      <span class="section-index" style="opacity:0.5;">[5]</span>
      <h2 style="margin-top:12px;">Price</h2>
      <div style="margin-top:24px; font-size:clamp(36px,6vw,56px); font-weight:800;">€379</div>
      <p style="margin-top:20px; max-width:48ch; margin-left:auto; margin-right:auto; opacity:0.8;">Pay in full or in interest-free installments over 6–12 months — that's about €30/month.</p>
      <a href="/en/contact/" class="btn btn-inverse" style="margin-top:28px;">Sign up for "Base"</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-index">[6]</span>
      <h2 style="margin-top:12px;">Frequently asked questions</h2>
      <div class="faq-list" style="margin-top:32px;">
        {faq.map(([q, a]) => (
          <div class="faq-item">
            <button class="faq-q"><span>{q}</span><span class="plus"></span></button>
            <div class="faq-a"><div class="faq-a-inner">{a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt final-cta">
    <div class="container">
      <span class="eyebrow">Sacred Ink Academy</span>
      <h2 style="margin-top:16px; font-size:clamp(22px,3vw,32px); text-transform:none;">Have a question? Write to me — I'll answer.</h2>
      <a href="/en/contact/" class="btn btn-primary">Message Kateryna</a>
    </div>
  </section>
</BaseLayout>
