---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReviewsGallery from '../../../components/ReviewsGallery.astro';
import WorksGallery from '../../../components/WorksGallery.astro';
import { videoReviews, imageReviews } from '../../../lib/reviews.js';
import { works } from '../../../lib/works.js';

const chicagoCarousel = Array.from({ length: 10 }, (_, i) => ({
  src: `/images/results/chicago/carousel-${String(i + 1).padStart(2, '0')}.jpeg`,
  alt: 'From zero to her own studio in Chicago — a step in the journey',
}));

const vikaCarousel = Array.from({ length: 9 }, (_, i) => ({
  src: `/images/results/vika/carousel-${String(i + 1).padStart(2, '0')}.jpeg`,
  alt: 'Vika — from zero to $19,000/year — a step in the story',
}));
---
<BaseLayout
  title="Sacred Ink student results — reviews & case studies"
  description="Real results and reviews from Sacred Ink Academy students: work, before/after, and stories from getting started to landing their first clients."
  path="/en/results/"
  lang="en"
>
  <section class="section page-hero">
    <div class="container">
      <nav class="breadcrumbs"><a href="/en/">Home</a><span>/</span><span>Results & reviews</span></nav>
      <span class="eyebrow">Student results</span>
      <h1 style="margin-top:16px;">Sacred Ink<br>student results</h1>
      <p class="hero-sub">Real stories — from starting with zero experience to landing paying clients.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="case-body" style="max-width:820px;">
        <span class="case-meta">Student case study · one year</span>
        <h3>Vika — from zero to ~$19,000 in a year</h3>
        <p style="opacity:0.75; font-size:15px; line-height:1.6;"><b>Starting point.</b> A year ago Vika worked in a completely different field, in a small town. Tattooing was a dream — but the fears felt stronger: "what if it doesn't work out?", "how do I leave a stable job?", "where would clients even come from?" Her first pieces didn't come out well. But she didn't stop.</p>
        <p style="opacity:0.75; font-size:15px; line-height:1.6; margin-top:10px;"><b>What she did:</b></p>
        <ul style="margin:0; padding-left:20px; display:flex; flex-direction:column; gap:6px; opacity:0.75; font-size:15px; line-height:1.5;">
          <li>She didn't quit her job right away — she balanced work and training, giving herself time to build skill</li>
          <li>She worked until it was right: when something didn't turn out, she redid it, looking for solutions instead of excuses</li>
          <li>She built her portfolio step by step — from simple sketches to complex pieces</li>
          <li>She ran her Instagram systematically — not chaos, but clear steps: what to post and how to attract clients</li>
        </ul>
        <p style="opacity:0.75; font-size:15px; line-height:1.6; margin-top:10px;"><b>The turning point.</b> Vika realized the fear of being broke was smaller than the fear of never trying. She quit her job. And the thing she feared least happened — clients showed up.</p>
        <p style="opacity:0.75; font-size:15px; line-height:1.6;"><b>Where she is now.</b> In one year — roughly $19,000. That's about $1,600/month. Starting from zero. From a small town. With no connections in the tattoo industry. From my online course and my support.</p>
        <p style="font-style:italic; opacity:0.85; font-size:15px; line-height:1.6; border-left:2px solid rgba(15,3,2,.25); padding-left:14px;">"Stability isn't a fixed salary. Stability is confidence in your own skills."</p>
        <p style="font-size:15px; line-height:1.6; font-weight:600;">Vika started when she was 30% ready. Not 100%. At 30% — and that's exactly why she's already there, instead of "someday later."</p>
      </div>
      <div style="margin-top:32px;"><WorksGallery items={vikaCarousel} lang="en" /></div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <span class="case-meta">Student case study</span>
      <h3 style="margin-top:10px; font-size:clamp(20px,2.6vw,28px);">From zero to her own studio in Chicago</h3>
      <div style="margin-top:24px;"><WorksGallery items={chicagoCarousel} lang="en" /></div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="section-index">[2]</span>
      <h2 style="margin-top:12px;">Student work gallery</h2>
      <div style="margin-top:28px;"><WorksGallery items={works} lang="en" /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ReviewsGallery heading="Reviews" index="[3]" images={imageReviews} videos={videoReviews} lang="en" />
    </div>
  </section>

  <section class="section section-black final-cta">
    <div class="container">
      <span class="eyebrow" style="opacity:0.7;">Sacred Ink Academy</span>
      <h2 style="margin-top:16px;">Become the next success story</h2>
      <a href="/en/free-tattoo-course/" class="btn btn-inverse">Try 5 days for free</a>
    </div>
  </section>
</BaseLayout>
