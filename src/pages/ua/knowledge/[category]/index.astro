---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCategories, getArticles } from '../../../../lib/contentful.js';

export async function getStaticPaths() {
  try {
    const categories = await getCategories();
    return categories.map((cat) => ({ params: { category: cat.slug }, props: { category: cat } }));
  } catch {
    return [];
  }
}

const { category } = Astro.props;
const articles = await getArticles({ categorySlug: category.slug });
---
<BaseLayout
  title={`${category.title} — База знань Sacred Ink`}
  description={category.description || `Матеріали категорії ${category.title} від Sacred Ink Academy.`}
  path={`/ua/knowledge/${category.slug}/`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Головна', item: 'https://sacredinkacademy.com/ua/' },
      { '@type': 'ListItem', position: 2, name: 'База знань', item: 'https://sacredinkacademy.com/ua/knowledge/' },
      { '@type': 'ListItem', position: 3, name: category.title, item: `https://sacredinkacademy.com/ua/knowledge/${category.slug}/` },
    ],
  }}
>
  <section class="section page-hero">
    <div class="container">
      <nav class="breadcrumbs"><a href="/ua/">Головна</a><span>/</span><a href="/ua/knowledge/">База знань</a><span>/</span><span>{category.title}</span></nav>
      <span class="eyebrow">Категорія</span>
      <h1 style="margin-top:16px;">{category.title}</h1>
      {category.description && <p class="hero-sub">{category.description}</p>}
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      {articles.length > 0 ? (
        <div class="kb-grid">
          {articles.map((a) => (
            <a class="kb-card" href={`/ua/knowledge/${category.slug}/${a.slug}/`}>
              <span class="kb-cat">{category.title}</span>
              <span class="kb-title">{a.title}</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="stub-note">У цій категорії ще немає опублікованих статей.</div>
      )}
    </div>
  </section>

  <section class="section section-black final-cta">
    <div class="container">
      <span class="eyebrow" style="opacity:0.7;">Sacred Ink Academy</span>
      <h2 style="margin-top:16px;">Спробуй 5 днів безкоштовно</h2>
      <a href="/ua/free-tattoo-course/" class="btn btn-inverse">Спробувати безкоштовно</a>
    </div>
  </section>
</BaseLayout>
