# Copy this file to .env and fill in your Contentful credentials
# (Settings -> API keys in the Contentful web app)
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=

# Telegram bot that receives contact-form submissions.
# 1. Message @BotFather in Telegram -> /newbot -> follow the steps -> copy the token it gives you.
# 2. Add the bot to the chat/group/channel where you want to receive заявки, then find that chat's id
#    (e.g. message the bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
